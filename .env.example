# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here

# Channel Whitelist (comma-separated channel IDs, leave empty to allow all channels)
# Example: ALLOWED_CHANNEL_IDS=1234567890123456789,9876543210987654321
ALLOWED_CHANNEL_IDS=

# Google Cloud Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VEO_MODEL_ID=veo-3.0-generate-001
OUTPUT_BUCKET=discord-video-gen-bot-us-central1

# Banana (Image Generation) Configuration
# API Mode: 'gemini' (uses Gemini API) or 'vertex' (uses Vertex AI)
BANANA_API_MODE=gemini
BANANA_MODEL_ID=gemini-3-pro-image-preview

# Required when BANANA_API_MODE=gemini
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Gemini API URLs (e.g., for proxies)
# Default: https://generativelanguage.googleapis.com
# FREE_CREDIT_GEMINI_API_URL=https://your-free-credit-proxy.com
# USER_GEMINI_API_URL=https://generativelanguage.googleapis.com

# Optional: Service Account JSON path for local development
# In production, use Application Default Credentials (ADC)
# SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# Public Access Mode
# object: Make individual objects public (requires Fine-grained ACL on bucket - recommended)
# bucket: Bucket-wide public access (simpler but less secure)
PUBLIC_ACCESS_MODE=object

# Database Configuration (required)
DATABASE_URL=postgresql://user:password@localhost:5432/discord_video_dev

# Database Connection Pool (optional, defaults shown)
# DATABASE_MAX_CONNECTIONS=10

# User API Key Binding (required for /api-key command)
# 32-character secret for encrypting user-provided Gemini API keys
# Generate with: openssl rand -base64 32 | head -c 32
API_KEY_ENCRYPTION_SECRET=your_32_character_secret_here!!

# Base URL for the web interface (used in /api-key connect command)
# Set this to your bot's public URL in production
BASE_URL=http://localhost:3000

# Request Data Retention (optional - days to keep old requests, default: unlimited)
# REQUEST_RETENTION_DAYS=90

# Redis Configuration (optional - for caching future features)
# REDIS_URL=redis://localhost:6379

# Video Attachment Configuration (optional)
# Maximum concurrent video downloads/attachments to Discord (default: 5)
# Limits bandwidth usage during high load
# MAX_CONCURRENT_ATTACHMENTS=5

# HTTP Server Configuration
# Port for API endpoints and web interface
PORT=3000

# Logging
LOG_LEVEL=info
NODE_ENV=development
